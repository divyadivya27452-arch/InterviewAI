# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/interview_ai

# Flask Session & JWT Secret Key (replace with a strong random string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Optional: Google Gemini API Key for LLM-powered answer evaluation
# Leave blank to use the built-in rule-based evaluator
GEMINI_API_KEY=

# Optional Flask settings
FLASK_DEBUG=True
PORT=5000
